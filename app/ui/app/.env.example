# Configuração opcional do frontend (Vite). Copie para .env e preencha.
# NÃO comite o .env com valores reais.

# clientId PÚBLICO de embed do Brandfetch (não é o token secreto de API).
# Quando definido, o marketplace de conectores mostra os logos das marcas pela
# CDN do Brandfetch (uso do operador, licenciado pela sua conta). Sem ele, a UI
# usa monogramas coloridos por padrão — o repositório não embute logos de terceiros.
VITE_BRANDFETCH_CLIENT_ID=
