{
  "expo": {
    "name": "HADES",
    "slug": "hades",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "hades",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": { "fallbackToCacheTimeout": 0 },
    "plugins": ["expo-secure-store", ["expo-notifications", { "color": "#171717" }]],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dz23ltd.hades",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.dz23ltd.hades",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": { "backgroundColor": "#111111" }
    },
    "web": { "bundler": "metro" }
  }
}
