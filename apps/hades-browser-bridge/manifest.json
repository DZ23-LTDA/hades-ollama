{
  "manifest_version": 3,
  "name": "HADES Browser Bridge",
  "version": "0.1.0",
  "description": "Conecta ao HADES apenas as abas que o utilizador autorizar explicitamente. Nao le campos sensiveis e nao tem poder sobre o computador.",
  "minimum_chrome_version": "116",
  "icons": {
    "192": "icons/hades-icon-192.png",
    "512": "icons/hades-icon-512.png"
  },
  "action": {
    "default_title": "HADES Browser Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "192": "icons/hades-icon-192.png"
    }
  },
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "src/content_script.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "incognito": "not_allowed",
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
